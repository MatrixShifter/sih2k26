# ==============================================================================
# ComplyGeM AI — Backend Environment Variables (.env.example)
# ==============================================================================
# Used by: Render (Production) / Local Development
# For local dev: Copy this file to .env and adjust values if needed.
# For Render: Configure these key-value pairs in the Render Dashboard.
# ==============================================================================

# Application Environment (development / production)
APP_NAME=ComplyGeM AI
APP_ENV=production

# JWT Authentication Secret (Generate a strong 64-character random string)
# e.g., openssl rand -hex 32
SECRET_KEY=your-production-jwt-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Connection (Supabase PostgreSQL for Production / SQLite for Local)
# Supabase Pooler (Recommended for Render):
# DATABASE_URL=postgresql://postgres.your_project_ref:your_password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
# Direct Connection:
# DATABASE_URL=postgresql://postgres:your_password@db.your_project_ref.supabase.co:5432/postgres?sslmode=require
# Local SQLite default:
DATABASE_URL=sqlite:///./complygem.db

# Frontend Domain for CORS (Your Vercel Deployment URL)
FRONTEND_URL=https://your-frontend.vercel.app

# Additional CORS Origins (comma-separated)
CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173,http://localhost:3000

# File Upload Settings
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=15
