# ==============================================================================
# ComplyGeM AI — Backend Environment Configuration Example
# ==============================================================================
# Rename this file to .env for local development or configure these variables
# directly in your Render Dashboard / hosting provider.
# DO NOT commit real secrets or production passwords to version control.
# ==============================================================================

# Application Details
APP_NAME=ComplyGeM AI
APP_ENV=production
PORT=8000
SECRET_KEY=generate_a_secure_random_64_character_hex_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ==============================================================================
# Database Configuration (Supabase PostgreSQL or Local SQLite)
# ==============================================================================
# For Supabase PostgreSQL (Session / Direct Connection):
# DATABASE_URL=postgresql://postgres:your_db_password@db.your_project_ref.supabase.co:5432/postgres?sslmode=require
#
# For Supabase Connection Pooler (Transaction Mode, Port 6543):
# DATABASE_URL=postgresql://postgres.your_project_ref:your_db_password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
#
# For Local Development SQLite default:
DATABASE_URL=sqlite:///./complygem.db

# ==============================================================================
# CORS & Frontend Origins
# ==============================================================================
# Set FRONTEND_URL to your deployed Vercel domain:
FRONTEND_URL=https://your-frontend.vercel.app

# Comma-separated list of allowed origins:
CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ==============================================================================
# Supabase API Credentials (Optional - Server Side Only)
# ==============================================================================
# IMPORTANT: SUPABASE_SERVICE_ROLE_KEY must NEVER be exposed to Vercel/Frontend.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# File Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=15
