APP_NAME=ComplyGeM AI
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Local Windows (no Docker): SQLite is the default in .env
# DATABASE_URL=sqlite:///./complygem.db
#
# PostgreSQL (Docker Compose):
# DATABASE_URL=postgresql+psycopg://complygem:complygem@postgres:5432/complygem
DATABASE_URL=sqlite:///./complygem.db

CORS_ORIGINS=http://localhost:5173,http://localhost:8080

UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=15
