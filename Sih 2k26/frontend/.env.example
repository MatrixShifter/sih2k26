# ==============================================================================
# ComplyGeM AI — Frontend Environment Configuration Example
# ==============================================================================
# Configure this in your Vercel Project Settings > Environment Variables
# or rename to .env.local for local Vite development.
# ==============================================================================

# Production Backend API URL (Your Render backend domain without trailing slash)
# Example: https://complygem-backend.onrender.com
VITE_API_URL=https://sih2k26-s3f0.onrender.com

# Optional fallback alias (supports both VITE_API_URL and VITE_API_BASE)
# VITE_API_BASE=https://your-backend.onrender.com

# Optional: Supabase Public Anon Key (Only if frontend directly uses Supabase client)
# NEVER put SUPABASE_SERVICE_ROLE_KEY here.
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_ANON_KEY=your_public_anon_key_here
